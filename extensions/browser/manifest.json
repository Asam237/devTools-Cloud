{
  "manifest_version": 3,
  "name": "DevTools Cloud",
  "short_name": "DevTools Cloud",
  "version": "0.1.0",
  "description": "JSON, JWT, Base64, URL and hash tools in one popup. Runs entirely in your browser, nothing is sent to a server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
