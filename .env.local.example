# Firebase project config (Project settings → General → Your apps → SDK setup and configuration).
# All client-side tools work without these set — auth and the dashboard simply stay disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Absolute site URL, used to build canonical links, sitemap entries, and OG images.
# On Vercel: set this explicitly in Project Settings → Environment Variables (Production) to your
# real domain, e.g. https://devtoolscloud.vercel.app — don't rely only on the automatic fallback
# below, since it depends on a project setting you may not have verified.
# Falls back to NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL (auto-injected by Vercel, only if
# "Automatically expose System Environment Variables" is enabled for the project), then to
# localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# Firebase Admin service account (Project settings → Service accounts → Generate new private key).
# Server-only, never exposed to the browser. Optional: without these, public snippet pages
# (/snippets, /snippets/[id]) and the community teaser on the landing page render a graceful
# "not available" state instead — everything else (tools, auth, dashboard) keeps working.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
